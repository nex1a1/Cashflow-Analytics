# Production image: Express serves the API and the built frontend from one port (no Vite, no tsx watch).
FROM node:24.22.1-alpine AS web
WORKDIR /web
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend ./
RUN npm run build

FROM node:24.22.1-alpine AS api
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY backend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY backend/tsconfig.json backend/server.ts ./
COPY backend/src ./src
RUN npm run build && npm prune --omit=dev

FROM node:24.22.1-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3000 TZ=Asia/Bangkok \
    DB_PATH=/app/data/cashflow.db BACKUP_DIR=/app/backups PUBLIC_DIR=/app/public
COPY --from=api /app/node_modules ./node_modules
COPY --from=api /app/dist ./dist
COPY backend/package.json ./
COPY --from=web /web/dist ./public
EXPOSE 3000
CMD ["node", "dist/server.js"]
